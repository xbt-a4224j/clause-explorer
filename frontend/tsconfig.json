{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "baseUrl": ".",
    // Mirrors the Vite alias. Two places rather than one because tsc and Vite resolve
    // independently; they are checked against each other by the build, which fails loudly if
    // they disagree.
    "paths": { "@semantic-explorer-base/ui": ["./vendor/semantic-explorer-base-ui/src/index.ts"] }
  },
  "include": ["src", "vendor/semantic-explorer-base-ui/src"]
}
